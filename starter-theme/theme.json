{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "papir", "name": "Papir", "color": "#FAFBFC" },
				{ "slug": "tinta", "name": "Tinta", "color": "#14203A" },
				{ "slug": "ultramarin", "name": "Ultramarin", "color": "#2E3FD6" },
				{ "slug": "magla", "name": "Magla", "color": "#5A6275" },
				{ "slug": "linija", "name": "Linija", "color": "#D6DAE3" },
				{ "slug": "povrsina", "name": "Površina", "color": "#EEF1F7" }
			]
		},
		"layout": { "contentSize": "680px", "wideSize": "1240px" },
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 3.5vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 8vw, 6.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "grotesk",
					"name": "Schibsted Grotesk",
					"fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Schibsted Grotesk", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibsted-grotesk.woff2" ] },
						{ "fontFamily": "Schibsted Grotesk", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/schibsted-grotesk-italic.woff2" ] }
					]
				},
				{
					"slug": "literata",
					"name": "Literata",
					"fontFamily": "Literata, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata.woff2" ] },
						{ "fontFamily": "Literata", "fontStyle": "italic", "fontWeight": "200 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/literata-italic.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "Sitno", "size": "0.8125rem", "fluid": false },
				{ "slug": "s", "name": "Malo", "size": "0.9375rem", "fluid": false },
				{ "slug": "m", "name": "Tekst", "size": "1.1875rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "l", "name": "Veliko", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "xl", "name": "Naslov", "size": "2.125rem", "fluid": { "min": "1.625rem", "max": "2.125rem" } },
				{ "slug": "xxl", "name": "Glavni naslov", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } },
				{ "slug": "masthead", "name": "Zaglavlje", "size": "clamp(3rem, 1.4rem + 7.4vw, 7.25rem)", "fluid": false }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|papir", "text": "var:preset|color|tinta" },
		"typography": {
			"fontFamily": "var:preset|font-family|literata",
			"fontSize": "var:preset|font-size|m",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" }
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|ultramarin" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|tinta" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|grotesk",
					"fontWeight": "750",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xxl", "lineHeight": "1.04", "letterSpacing": "-0.025em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xl" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|l" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|m" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|s" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|xs" } },
			"caption": {
				"color": { "text": "var:preset|color|magla" },
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|xs", "lineHeight": "1.45" }
			},
			"button": {
				"color": { "background": "var:preset|color|tinta", "text": "var:preset|color|papir" },
				"border": { "radius": "4px" },
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|s", "fontWeight": "650" },
				"spacing": { "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.25rem", "right": "1.25rem" } },
				":hover": { "color": { "background": "var:preset|color|ultramarin" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontWeight": "850", "lineHeight": "0.92", "letterSpacing": "-0.045em" },
				"elements": { "link": { "color": { "text": "var:preset|color|tinta" }, "typography": { "textDecoration": "none" } } }
			},
			"core/site-tagline": {
				"color": { "text": "var:preset|color|magla" },
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|xs", "fontWeight": "500" }
			},
			"core/navigation": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|s", "fontWeight": "650" },
				"elements": { "link": { "typography": { "textDecoration": "none" }, ":hover": { "typography": { "textDecoration": "underline" } } } }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontWeight": "750", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
				"elements": { "link": { "color": { "text": "var:preset|color|tinta" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-terms": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|s", "fontWeight": "650" },
				"elements": { "link": { "color": { "text": "var:preset|color|ultramarin" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-author-name": {
				"color": { "text": "var:preset|color|tinta" },
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|xs", "fontWeight": "650" },
				"elements": { "link": { "color": { "text": "var:preset|color|tinta" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|magla" },
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|xs" },
				"elements": { "link": { "color": { "text": "var:preset|color|magla" } } }
			},
			"core/post-excerpt": {
				"typography": { "lineHeight": "1.55" }
			},
			"core/post-author": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|s" }
			},
			"core/query-title": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk" }
			},
			"core/term-description": {
				"color": { "text": "var:preset|color|magla" },
				"typography": { "fontSize": "var:preset|font-size|l", "lineHeight": "1.45" }
			},
			"core/query-pagination": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|s", "fontWeight": "650" },
				"elements": { "link": { "color": { "text": "var:preset|color|tinta" } } }
			},
			"core/search": {
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|s" }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|ultramarin", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontStyle": "italic" }
			},
			"core/pullquote": {
				"border": { "width": "0px", "style": "none" },
				"spacing": { "padding": { "top": "var:preset|spacing|40", "bottom": "var:preset|spacing|40", "left": "0", "right": "0" } },
				"typography": { "fontFamily": "var:preset|font-family|grotesk", "fontSize": "var:preset|font-size|xl", "fontWeight": "750", "lineHeight": "1.2", "letterSpacing": "-0.015em" },
				"color": { "text": "var:preset|color|ultramarin" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|linija" }
			},
			"core/list": {
				"spacing": { "padding": { "left": "1.25em" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Zaglavlje", "area": "header" },
		{ "name": "footer", "title": "Podnožje", "area": "footer" },
		{ "name": "post-meta", "title": "Potpis i datum", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Stranica bez naslova", "postTypes": [ "page" ] }
	]
}
